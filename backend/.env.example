# AI2LaTeX — optional configuration.
# Copy this file to .env and fill in what you have.

# Google Gemini 2.5 Flash. When empty, the app runs on the built-in
# deterministic tutor so every screen still works offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: override the session signing secret.
AI2LATEX_SECRET=
