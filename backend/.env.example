# AI2LaTeX — optional configuration.
# Copy this file to .env and fill in what you have. Every value is optional:
# with an empty file the app runs on the offline tutor, dev email delivery and
# CAPTCHA-only signup.

# ---------------------------------------------------------------------------
# Google Gemini (AI features). When empty, the app runs on the built-in
# deterministic tutor so every screen still works offline.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
# Model id resolved at call time. gemini-3.5-flash-lite is verified for chat,
# strict-JSON polish and vision OCR. Do not use gemini-2.5-flash (retired for
# new users: HTTP 404) or gemini-3.5-flash (503 under high demand).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: override the session signing secret (defaults to a dev value).
AI2LATEX_SECRET=

# ---------------------------------------------------------------------------
# Real Google sign-in (optional). Create an OAuth 2.0 Web client at
# https://console.cloud.google.com/apis/credentials and add your frontend
# origins as Authorised JavaScript origins. When set, GOOGLE_CLIENT_ID is also
# handed to the frontend through GET /api/health and /api/auth/google/config.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Email delivery (optional). Without SMTP_HOST the API runs in "dev" mode and
# returns the 6-digit verification code in the JSON response (devCode) instead
# of emailing it. With SMTP_HOST set, codes are only ever emailed.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI2LaTeX <no-reply@ai2latex.local>
# 1 (default) upgrades the connection with STARTTLS; 0 disables it (port 465
# always uses implicit TLS).
SMTP_STARTTLS=1

# Set to 0 to disable POST /api/auth/demo ("Continue as demo scholar").
AI2LATEX_DEMO_LOGIN=1

# Public base URL, used in the links inside verification emails.
AI2LATEX_BASE_URL=http://127.0.0.1:3101
