# Normalise line endings so the repo behaves the same on Windows and Unix.
* text=auto eol=lf

# Shell scripts must keep LF.
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.zip binary
*.db binary

# Lockfiles: generated, but diff-friendly noise
pnpm-lock.yaml linguist-generated=true
